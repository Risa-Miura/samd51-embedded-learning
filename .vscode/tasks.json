{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docs: preview",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "mkdocs",
        "serve"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Docs: build and check",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Docs: strict build",
        "Docs: check links"
      ],
      "problemMatcher": []
    },
    {
      "label": "Docs: strict build",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "mkdocs",
        "build",
        "--strict",
        "--clean"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Docs: check links",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "scripts/check_links.py"
      ],
      "problemMatcher": [],
      "windows": {
        "command": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
