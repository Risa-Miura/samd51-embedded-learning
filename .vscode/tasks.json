{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docs: preview",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "mkdocs",
        "serve"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docs: build and check",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Docs: strict build",
        "Docs: check links"
      ],
      "problemMatcher": []
    },
    {
      "label": "Docs: strict build",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "mkdocs",
        "build",
        "--strict",
        "--clean"
      ],
      "problemMatcher": []
    },
    {
      "label": "Docs: check links",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/check_links.py"
      ],
      "problemMatcher": []
    }
  ]
}
